// Secrets.xcconfig.template
// Copy this file to Secrets.xcconfig and fill in the real proxy key.
// Secrets.xcconfig is gitignored and must never be committed.

PROXY_KEY = your-proxy-key-here

// Supabase connection (fill real values in Secrets.xcconfig; anon key is the publishable one)
SUPABASE_URL = https:/$()/your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-anon-key-here
